# Copy this to .env.local and fill in your values

# OneChain RPC (use localhost for local Hardhat node)
NEXT_PUBLIC_ONECHAIN_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_ONECHAIN_CHAIN_ID=31337

# WalletConnect (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Contract Addresses (auto-filled by deploy script)
NEXT_PUBLIC_ONE_TOKEN_ADDRESS=0x
NEXT_PUBLIC_ATHLETE_NFT_ADDRESS=0x
NEXT_PUBLIC_POINTS_ORACLE_ADDRESS=0x
NEXT_PUBLIC_FANTASY_TEAM_ADDRESS=0x
NEXT_PUBLIC_LEAGUE_MANAGER_ADDRESS=0x
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=0x
NEXT_PUBLIC_BETTING_POOL_ADDRESS=0x
